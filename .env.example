# ───────── Үндсэн ─────────
# Сайтын бүтэн хаяг (SEO, sitemap, QPay callback-д ашиглана). Төгсгөлд "/" бүү тавь.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL холболт
DATABASE_URL="postgresql://jdstore:jdstore@localhost:5432/jdstore?schema=public"

# Админ session болон захиалгын холбоос гарын үсэгт ашиглах нууц түлхүүр (32+ тэмдэгт).
# Үүсгэх: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Анхны админ (seed үед үүснэ / нууц үг шинэчлэгдэнэ)
ADMIN_EMAIL="lutaajamsran@gmail.com"
ADMIN_PASSWORD="change-me-strong-password"

# ───────── Холбоо барих (админ → Тохиргоо хэсгээс дарж бичиж болно) ─────────
NEXT_PUBLIC_CONTACT_PHONE="95209563"
NEXT_PUBLIC_CONTACT_EMAIL="lutaajamsran@gmail.com"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/"

# ───────── И-мэйл мэдэгдэл (SMTP) ─────────
# Gmail: 2-Step Verification асааж, App Password үүсгээд SMTP_PASS-д тавина.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="JDstore <no-reply@jdstore.mn>"
ORDER_NOTIFY_EMAIL="lutaajamsran@gmail.com"

# ───────── QPay ─────────
# QPAY_MODE: "sandbox" | "production" | "mock"
#   mock      – сүлжээгүй локал туршилт (жинхэнэ төлбөр БИШ). Production-д хэзээ ч бүү ашигла.
#   sandbox   – https://merchant-sandbox.qpay.mn
#   production– https://merchant.qpay.mn
QPAY_MODE="sandbox"
QPAY_BASE_URL="https://merchant-sandbox.qpay.mn"
QPAY_CLIENT_ID="TEST_MERCHANT"
QPAY_CLIENT_SECRET="123456"
QPAY_INVOICE_CODE="TEST_INVOICE"
# QPay-ийн хүлээн авагчийн код (ихэвчлэн "terminal")
QPAY_INVOICE_RECEIVER_CODE="terminal"

# ───────── Зураг хадгалах ─────────
# Vercel дээр Vercel Blob холбоход автоматаар тавигдана. Хоосон бол ./uploads хавтаст хадгална.
BLOB_READ_WRITE_TOKEN=""

# QPay гэрээ хийгдэхээс өмнө "false" болгоход захиалгын хуудсанд QPay сонголт харагдахгүй
QPAY_ENABLED="true"

# ───────── Cron ─────────
# /api/cron/expire-orders-г хамгаална (Vercel Cron автоматаар "Authorization: Bearer CRON_SECRET" илгээнэ)
CRON_SECRET="change-me-random-string"
# Хэдэн цагийн дотор төлөгдөөгүй QPay захиалгыг цуцалж үлдэгдлийг буцаах вэ
QPAY_ORDER_EXPIRE_HOURS="24"
